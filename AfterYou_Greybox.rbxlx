        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[--!strict
-- Placeholder story text for the greybox. Final lines come from the story pass (C7).
return {
	Notes = {
		Clipboard = "Lift's out again. Fuses: one in the laundry, one in 4D (meter cupboard). 4A, knock twice, she's deaf. - T",
	},
	Tapes = {
		Tape01 = {
			{ At = 0, Text = "[click] It's Theo. Night four." },
			{ At = 3.5, Text = "The dust is how I know where I've been." },
			{ At = 7.5, Text = "Clean dust, nobody's been. It's the clean rooms you want." },
			{
				At = 12,
				Text = "Because whatever's walking around up here... it only goes where someone's already walked. [click]",
			},
		},
	},
	Objectives = {
		FindFuses = "Find two fuses (laundry, 4D)",
		PowerLift = "Put the fuses in the lift fuse box",
		TakeLift = "Take the lift",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">WearConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Tunables for the building's memory of footsteps. See MASTER_IMPLEMENTATION_PLAN.md §D.1.
return {
	-- Wear gained per second while a player is inside a cell, by movement mode.
	GainPerSecond = {
		Still = 0.004,
		Crouch = 0.012,
		Walk = 0.03,
		Run = 0.06,
	},
	-- Extra wear for entering a cell (crossing a threshold counts more than lingering).
	EnterBonus = 0.08,
	-- Wear decays exponentially; half-life in seconds (dust settling).
	HalfLifeSeconds = 360,
	-- The Lodger may enter a cell only at or above this wear.
	LodgerThreshold = 0.25,
	-- Server tick for wear accumulation.
	TickSeconds = 0.25,
	-- Replication: send deltas at most this often, and only if a value moved by this much (0-255 scale).
	ReplicateSeconds = 0.5,
	ReplicateMinStep = 2,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--!strict
-- Collects every event definition module in this folder. Adding an event = adding a file here
-- (plus a client presenter only if it introduces a new Category). Schema: Logic/EventSelector.
local list = {}
for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") then
		local def = (require :: any)(child)
		assert(def.Id == child.Name, "event Id must match its file name: " .. child.Name)
		table.insert(list, def)
	end
end
table.sort(list, function(a, b)
	return a.Id < b.Id
end)
return list
]]></string>
        </Properties>
