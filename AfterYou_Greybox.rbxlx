      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CellGraph</string>
            <string name="Source"><![CDATA[--!strict
-- Room/corridor graph built from LevelLayout. Pure data, testable outside Roblox.
type Rect = { number }
type CellDef = { Id: string, Rect: Rect, Tags: { string }? }
type OpeningDef = { Id: string, Kind: string, Cells: { string } }
type Layout = { Cells: { any }, Openings: { any } }

export type Edge = { To: string, Opening: string, Kind: string }
export type CellGraph = {
	Cells: { [string]: CellDef },
	Order: { string },
	Edges: { [string]: { Edge } },
}

local CellGraph = {}

function CellGraph.Build(layout: Layout): CellGraph
	local cells: { [string]: CellDef } = {}
	local order = {}
	local edges: { [string]: { Edge } } = {}
	for _, c in layout.Cells do
		assert(cells[c.Id] == nil, "duplicate cell " .. c.Id)
		cells[c.Id] = c
		table.insert(order, c.Id)
		edges[c.Id] = {}
	end
	for _, o in layout.Openings do
		if o.Kind ~= "Fake" and #o.Cells == 2 then
			local a, b = o.Cells[1], o.Cells[2]
			assert(cells[a] and cells[b], "opening " .. o.Id .. " references unknown cell")
			table.insert(edges[a], { To = b, Opening = o.Id, Kind = o.Kind })
			table.insert(edges[b], { To = a, Opening = o.Id, Kind = o.Kind })
		end
	end
	return { Cells = cells, Order = order, Edges = edges }
end

-- Returns the cell id containing (x, z) in layout-local coordinates, or nil.
function CellGraph.CellAt(graph: CellGraph, x: number, z: number): string?
	for _, id in graph.Order do
		local r = graph.Cells[id].Rect
		if x >= r[1] and x <= r[3] and z >= r[2] and z <= r[4] then
			return id
		end
	end
	return nil
end

function CellGraph.HasTag(graph: CellGraph, id: string, tag: string): boolean
	local tags = graph.Cells[id] and graph.Cells[id].Tags
	return tags ~= nil and table.find(tags, tag) ~= nil
end

-- Breadth-first route of cell ids from `from` to `to`, only through cells where canEnter(id) is true
-- (the start cell is always allowed). Returns nil if unreachable.
function CellGraph.Route(
	graph: CellGraph,
	from: string,
	to: string,
	canEnter: (string) -> boolean,
	canPass: ((Edge) -> boolean)?
): { string }?
	if from == to then
		return { from }
	end
	if not canEnter(to) then
		return nil
	end
	local prev: { [string]: string } = {}
	local seen = { [from] = true }
	local queue = { from }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		for _, e in graph.Edges[cur] do
			if not seen[e.To] and canEnter(e.To) and (canPass == nil or canPass(e)) then
				seen[e.To] = true
				prev[e.To] = cur
				if e.To == to then
					local route = { to }
					local node = to
					while prev[node] do
						node = prev[node]
						table.insert(route, 1, node)
					end
					return route
				end
				table.insert(queue, e.To)
			end
		end
	end
	return nil
end

-- Number of openings of the given kinds that are "closed" between two adjacent cells along a route.
function CellGraph.ClosedDoorsAlong(
	graph: CellGraph,
	route: { string },
	isClosed: (string) -> boolean
): number
	local n = 0
	for i = 1, #route - 1 do
		for _, e in graph.Edges[route[i]] do
			if e.To == route[i + 1] then
				if isClosed(e.Opening) then
					n += 1
				end
				break
			end
		end
	end
	return n
end

return CellGraph
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">EchoCodec</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Packs a recorded path into a buffer for one RemoteEvent send (MASTER_IMPLEMENTATION_PLAN §H).
	Layout:
	  u16 sampleCount, f32 sampleInterval, f32 quantum
	  per sample: i16 x, i16 y, i16 z, u8 yaw (0-255 => 0-2pi), u8 flags (bit0 flashlight on, bit1 running, bit2 crouching)
	  u16 actionCount
	  per action: u16 sampleIndex (1-based), u8 kind, u16 idLength, bytes id
	Positions are relative to the layout origin, quantised to `quantum` studs.
]]
export type Sample = { X: number, Y: number, Z: number, Yaw: number, Flags: number }
export type Action = { Index: number, Kind: number, Id: string }
export type Path = { Interval: number, Quantum: number, Samples: { Sample }, Actions: { Action } }

local EchoCodec = {}

EchoCodec.Flags = { Flashlight = 1, Running = 2, Crouching = 4 }
EchoCodec.ActionKind = { DoorOpen = 1, DoorClose = 2, Knock = 3, FlashOn = 4, FlashOff = 5, Pickup = 6 }

local TWO_PI = math.pi * 2
local SAMPLE_BYTES = 8

local function q(v: number, quantum: number): number
	return math.clamp(math.floor(v / quantum + 0.5), -32768, 32767)
end

function EchoCodec.Encode(path: Path): buffer
	local n = #path.Samples
	assert(n <= 65535, "too many samples")
	local size = 2 + 4 + 4 + n * SAMPLE_BYTES + 2
	for _, a in path.Actions do
		size += 2 + 1 + 2 + #a.Id
	end
	local b = buffer.create(size)
	local o = 0
	buffer.writeu16(b, o, n)
	o += 2
	buffer.writef32(b, o, path.Interval)
	o += 4
	buffer.writef32(b, o, path.Quantum)
	o += 4
	for _, s in path.Samples do
		buffer.writei16(b, o, q(s.X, path.Quantum))
		o += 2
		buffer.writei16(b, o, q(s.Y, path.Quantum))
		o += 2
		buffer.writei16(b, o, q(s.Z, path.Quantum))
		o += 2
		local yaw = s.Yaw % TWO_PI
		buffer.writeu8(b, o, math.floor(yaw / TWO_PI * 256) % 256)
		o += 1
		buffer.writeu8(b, o, s.Flags)
		o += 1
	end
	buffer.writeu16(b, o, #path.Actions)
	o += 2
	for _, a in path.Actions do
		buffer.writeu16(b, o, a.Index)
		o += 2
		buffer.writeu8(b, o, a.Kind)
		o += 1
		buffer.writeu16(b, o, #a.Id)
		o += 2
		buffer.writestring(b, o, a.Id)
		o += #a.Id
	end
	return b
end

function EchoCodec.Decode(b: buffer): Path
	local o = 0
	local n = buffer.readu16(b, o)
	o += 2
	local interval = buffer.readf32(b, o)
	o += 4
	local quantum = buffer.readf32(b, o)
	o += 4
	local samples = table.create(n)
	for i = 1, n do
		local x = buffer.readi16(b, o) * quantum
		o += 2
		local y = buffer.readi16(b, o) * quantum
		o += 2
		local z = buffer.readi16(b, o) * quantum
		o += 2
		local yaw = buffer.readu8(b, o) / 256 * TWO_PI
		o += 1
		local flags = buffer.readu8(b, o)
		o += 1
		samples[i] = { X = x, Y = y, Z = z, Yaw = yaw, Flags = flags }
	end
	local m = buffer.readu16(b, o)
	o += 2
	local actions = table.create(m)
	for i = 1, m do
		local idx = buffer.readu16(b, o)
		o += 2
		local kind = buffer.readu8(b, o)
		o += 1
		local len = buffer.readu16(b, o)
		o += 2
		local id = buffer.readstring(b, o, len)
		o += len
		actions[i] = { Index = idx, Kind = kind, Id = id }
	end
	return { Interval = interval, Quantum = quantum, Samples = samples, Actions = actions }
end

return EchoCodec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">EventSelector</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Chooses which horror event (if any) to play for one player. Pure.
	Event definitions live in ReplicatedStorage.Shared.Events; see §J.3 for the schema.
]]
export type Requires = {
	Tags: { string }?,
	Cells: { string }?,
	PlayerAlone: boolean?,
	MinWearInCell: number?,
	MaxWearInCell: number?,
	EchoHistorySeconds: number?,
	Flag: string?, -- a game flag that must be set (e.g. "HasTape01")
	NotFlag: string?,
}
export type EventDef = {
	Id: string,
	Category: string,
	Intensity: number,
	MinProgress: number?,
	Cooldown: number,
	Weight: number,
	States: { string },
	Requires: Requires?,
	MaxPlaysPerSession: number?,
	Scripted: boolean?, -- only fired by scripted triggers, never selected by the Director
}
export type Context = {
	State: string,
	Progress: number,
	Cell: string?,
	CellTags: { string },
	CellWear: number,
	Alone: boolean,
	EchoHistorySeconds: number,
	Flags: { [string]: boolean },
}
export type History = {
	LastByEvent: { [string]: number },
	PlaysByEvent: { [string]: number },
	LastAny: number,
	LastMajor: number,
	Recent: { { Category: string, At: number } },
}

local EventSelector = {}

function EventSelector.NewHistory(): History
	return { LastByEvent = {}, PlaysByEvent = {}, LastAny = -math.huge, LastMajor = -math.huge, Recent = {} }
end

function EventSelector.Record(h: History, def: EventDef, now: number, cfg: any)
	h.LastByEvent[def.Id] = now
	h.PlaysByEvent[def.Id] = (h.PlaysByEvent[def.Id] or 0) + 1
	h.LastAny = now
	if def.Intensity >= cfg.MajorIntensity then
		h.LastMajor = now
	end
	table.insert(h.Recent, { Category = def.Category, At = now })
	-- Drop entries outside the recency window.
	local cutoff = now - cfg.RecentWindowSeconds
	while h.Recent[1] and h.Recent[1].At < cutoff do
		table.remove(h.Recent, 1)
	end
end

local function anyTag(have: { string }, want: { string }): boolean
	for _, t in want do
		if table.find(have, t) then
			return true
		end
	end
	return false
end

-- Returns a reason string when the event is not eligible (useful for the debug overlay), else nil.
function EventSelector.Ineligible(def: EventDef, ctx: Context, h: History, now: number, cfg: any): string?
	if def.Scripted then
		return "scripted"
	end
	if not table.find(def.States, ctx.State) then
		return "state"
	end
	if ctx.Progress < (def.MinProgress or 0) then
		return "progress"
	end
	if now - (h.LastByEvent[def.Id] or -math.huge) < def.Cooldown then
		return "cooldown"
	end
	if now - h.LastAny < cfg.MinSecondsBetweenEvents then
		return "spacing"
	end
	if def.Intensity >= cfg.MajorIntensity and now - h.LastMajor < cfg.MinSecondsBetweenMajor then
		return "majorSpacing"
	end
	if def.MaxPlaysPerSession and (h.PlaysByEvent[def.Id] or 0) >= def.MaxPlaysPerSession then
		return "maxPlays"
	end
	local r = def.Requires
	if r then
		if r.Tags and not anyTag(ctx.CellTags, r.Tags) then
			return "tags"
		end
		if r.Cells and (ctx.Cell == nil or not table.find(r.Cells, ctx.Cell)) then
			return "cell"
		end
		if r.PlayerAlone and not ctx.Alone then
			return "notAlone"
		end
		if r.MinWearInCell and ctx.CellWear < r.MinWearInCell then
			return "wearLow"
		end
		if r.MaxWearInCell and ctx.CellWear > r.MaxWearInCell then
			return "wearHigh"
		end
		if r.EchoHistorySeconds and ctx.EchoHistorySeconds < r.EchoHistorySeconds then
			return "history"
		end
		if r.Flag and not ctx.Flags[r.Flag] then
			return "flag"
		end
		if r.NotFlag and ctx.Flags[r.NotFlag] then
			return "notFlag"
		end
	end
	return nil
end

function EventSelector.Weight(def: EventDef, h: History, cfg: any): number
	local same = 0
	for _, r in h.Recent do
		if r.Category == def.Category then
			same += 1
		end
	end
	return def.Weight * (cfg.RecentCategoryPenalty ^ same)
end

-- Weighted random pick among eligible events. rng returns [0, 1).
function EventSelector.Select(
	defs: { EventDef },
	ctx: Context,
	h: History,
	now: number,
	cfg: any,
	rng: () -> number
): EventDef?
	local pool = {}
	local total = 0
	for _, def in defs do
		if EventSelector.Ineligible(def, ctx, h, now, cfg) == nil then
			local w = EventSelector.Weight(def, h, cfg)
			if w > 0 then
				total += w
				table.insert(pool, { def = def, w = w })
			end
		end
	end
	if total <= 0 then
		return nil
	end
	local pick = rng() * total
	for _, e in pool do
		pick -= e.w
		if pick < 0 then
			return e.def
		end
	end
	return pool[#pool].def
end

return EventSelector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LodgerBrain</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The Lodger's decision logic as a pure state machine (§I.2). LodgerService gathers perception
	into a Snapshot, calls Step, and carries out the returned state. No Roblox APIs here.
]]
export type State = "Dormant" | "Mimic" | "Deviate" | "Pursue" | "Search" | "Withdraw" | "Take"
export type Brain = {
	State: State,
	StateTime: number,
	Menace: number,
	SinceSeen: number,
}
export type Snapshot = {
	Dt: number,
	HasTarget: boolean,
	TargetVisible: boolean,
	TargetDistance: number,
	TargetReachable: boolean, -- target's cell is worn enough and connected through worn cells
	TargetLookingAtMe: boolean,
	HeardLoudness: number, -- 0..1 after attenuation
	RouteDone: boolean, -- current movement goal reached / echo route finished
}

local LodgerBrain = {}

function LodgerBrain.New(): Brain
	return { State = "Dormant", StateTime = 0, Menace = 0, SinceSeen = math.huge }
end

local function enter(b: Brain, s: State)
	b.State = s
	b.StateTime = 0
end

function LodgerBrain.Wake(b: Brain)
	if b.State == "Dormant" then
		enter(b, "Mimic")
		b.Menace = 0
		b.SinceSeen = math.huge
	end
end

function LodgerBrain.Finish(b: Brain)
	-- Take sequence or withdraw route complete.
	if b.State == "Take" then
		enter(b, "Withdraw")
	elseif b.State == "Withdraw" then
		enter(b, "Dormant")
	end
end

-- Returns the new state if it changed.
function LodgerBrain.Step(b: Brain, s: Snapshot, cfg: any): State?
	local before = b.State
	b.StateTime += s.Dt
	if s.TargetVisible then
		b.SinceSeen = 0
	else
		b.SinceSeen += s.Dt
	end

	-- Menace gauge: pressure on the player builds while it is close and seen; it must back off when full.
	if b.State ~= "Dormant" and b.State ~= "Withdraw" then
		if s.HasTarget and s.TargetDistance < cfg.MenaceNearDistance and s.TargetVisible then
			b.Menace = math.min(1, b.Menace + cfg.MenaceRisePerSecondNear * s.Dt)
		else
			b.Menace = math.max(0, b.Menace - cfg.MenaceDecayPerSecond * s.Dt)
		end
	end

	local st = b.State
	if st == "Dormant" or st == "Take" or st == "Withdraw" then
		-- Leaving these is driven by Wake/Finish.
		if st == "Withdraw" and s.RouteDone then
			enter(b, "Dormant")
		end
	elseif not s.HasTarget then
		enter(b, "Withdraw")
	elseif b.Menace >= cfg.MenaceWithdrawAt then
		enter(b, "Withdraw")
	elseif st == "Mimic" then
		local noticed = s.TargetVisible and s.TargetLookingAtMe and s.TargetDistance < 45
		if noticed or s.HeardLoudness >= 0.5 then
			enter(b, "Deviate")
		elseif s.RouteDone then
			-- The echo's route ran out near the player: it stops and turns to them (the deviation beat).
			if s.TargetVisible or s.TargetDistance <= cfg.MimicDeviateDistance then
				enter(b, "Deviate")
			else
				enter(b, "Withdraw")
			end
		end
	elseif st == "Deviate" then
		if b.StateTime >= cfg.DeviateHoldSeconds then
			enter(b, if s.TargetReachable then "Pursue" else "Search")
		end
	elseif st == "Pursue" then
		if s.TargetReachable and s.TargetDistance <= cfg.CatchDistance then
			enter(b, "Take")
		elseif not s.TargetReachable then
			enter(b, "Search") -- holds at the edge of clean dust
		elseif b.SinceSeen >= cfg.LoseSightSeconds and s.HeardLoudness < 0.3 then
			enter(b, "Search")
		end
	elseif st == "Search" then
		if s.TargetReachable and (s.TargetVisible or s.HeardLoudness >= 0.4) then
			enter(b, "Pursue")
		elseif b.StateTime >= cfg.SearchSeconds then
			enter(b, "Withdraw")
		end
	end
	if b.State ~= before then
		return b.State
	end
	return nil
end

return LodgerBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PacingModel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Per-player pacing state (Left 4 Dead director pattern: build-up, peak, fade, relax).
	Pure: callers own time and randomness. MASTER_IMPLEMENTATION_PLAN.md §J.2.
]]
export type StateName = "Relax" | "Build" | "Peak" | "Fade"
export type Pacing = {
	State: StateName,
	StateTime: number,
	StateDuration: number,
	Tension: number,
	PeakResolved: boolean,
}
export type Inputs = {
	Dt: number,
	Running: boolean,
	Dark: boolean,
	LodgerNear: boolean,
}

local PacingModel = {}

local function durationFor(cfg: any, state: StateName, rng: () -> number): number
	local s = cfg.States[state]
	local lo = s.MinSeconds or s.MaxSeconds
	local hi = s.MaxSeconds or lo
	return lo + (hi - lo) * rng()
end

function PacingModel.New(cfg: any, rng: () -> number): Pacing
	return {
		State = "Relax",
		StateTime = 0,
		StateDuration = durationFor(cfg, "Relax", rng),
		Tension = 0,
		PeakResolved = false,
	}
end

function PacingModel.Enter(p: Pacing, state: StateName, cfg: any, rng: () -> number, duration: number?)
	p.State = state
	p.StateTime = 0
	p.StateDuration = duration or durationFor(cfg, state, rng)
	p.PeakResolved = false
end

function PacingModel.AddTension(p: Pacing, amount: number)
	p.Tension = math.clamp(p.Tension + amount, 0, 100)
end

-- Called by the Director when the Peak's major beat has played out.
function PacingModel.ResolvePeak(p: Pacing)
	p.PeakResolved = true
end

-- Advances time and returns the new state name if a transition happened.
function PacingModel.Step(p: Pacing, input: Inputs, cfg: any, rng: () -> number): StateName?
	local dt = input.Dt
	p.StateTime += dt
	local gain = 0
	if input.Running then
		gain += cfg.TensionFromRunPerSecond
	end
	if input.Dark then
		gain += cfg.TensionFromDarkPerSecond
	end
	if input.LodgerNear then
		gain += cfg.TensionFromLodgerNearPerSecond
	end
	p.Tension = math.clamp(p.Tension + (gain - cfg.TensionDecayPerSecond) * dt, 0, 100)

	local s = p.State
	local nextState: StateName? = nil
	if s == "Relax" then
		if p.StateTime >= p.StateDuration then
			nextState = "Build"
		end
	elseif s == "Build" then
		if p.Tension >= cfg.BuildToPeakTension or p.StateTime >= p.StateDuration then
			nextState = "Peak"
		end
	elseif s == "Peak" then
		if p.PeakResolved or p.StateTime >= p.StateDuration then
			nextState = "Fade"
		end
	elseif s == "Fade" then
		if p.StateTime >= p.StateDuration then
			nextState = "Relax"
		end
	end
	if nextState then
		PacingModel.Enter(p, nextState, cfg, rng)
	end
	return nextState
end

-- Death or a scripted beat forces a long relax.
function PacingModel.ForceRelax(p: Pacing, seconds: number, cfg: any, rng: () -> number)
	PacingModel.Enter(p, "Relax", cfg, rng, seconds)
	p.Tension = math.min(p.Tension, 20)
end

return PacingModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WearMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure wear arithmetic (no Roblox APIs) so it can be unit-tested.
local WearMath = {}

function WearMath.Decay(w: number, dt: number, halfLife: number): number
	if w <= 0 then
		return 0
	end
	return w * (0.5 ^ (dt / halfLife))
end

function WearMath.Add(w: number, amount: number): number
	return math.clamp(w + amount, 0, 1)
end

function WearMath.ToByte(w: number): number
	return math.clamp(math.floor(w * 255 + 0.5), 0, 255)
end

function WearMath.FromByte(b: number): number
	return b / 255
end

-- Seconds until wear w decays below threshold (0 if already below).
function WearMath.SecondsUntilBelow(w: number, threshold: number, halfLife: number): number
	if w <= threshold or threshold <= 0 then
		return 0
	end
	return halfLife * math.log(w / threshold, 2)
end

return WearMath
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Every RemoteEvent in the game is declared here, once (MASTER_IMPLEMENTATION_PLAN §G.3, §H).
	Server: Net.Init() creates them; Net.OnServer(name, handler) validates args and rate-limits.
	Client: Net.OnClient / Net.FireServer wait for the server's instances.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

type Validator = (...any) -> boolean
type Def = { Unreliable: boolean?, RatePerSecond: number?, Validate: Validator? }

local function isInstance(v: any): boolean
	return typeof(v) == "Instance"
end

-- C->S remotes carry a validator and a rate limit. S->C remotes need neither.
local Defs: { [string]: Def } = {
	-- Client to server
	Interact = {
		RatePerSecond = 8,
		Validate = function(target, action)
			return isInstance(target) and type(action) == "string" and #action <= 16
		end,
	},
	HoldInteract = {
		RatePerSecond = 4,
		Validate = function(target, phase)
			return isInstance(target) and (phase == "Begin" or phase == "End")
		end,
	},
	Flashlight = {
		RatePerSecond = 6,
		Validate = function(on)
			return type(on) == "boolean"
		end,
	},
	Look = {
		Unreliable = true,
		RatePerSecond = 8,
		Validate = function(dir)
			return typeof(dir) == "Vector3" and dir.Magnitude > 0.5 and dir.Magnitude < 1.5
		end,
	},
	EventFeedback = {
		RatePerSecond = 4,
		Validate = function(token, noticed)
			return type(token) == "number" and type(noticed) == "boolean"
		end,
	},
	Stance = {
		RatePerSecond = 6,
		Validate = function(stance)
			return stance == "Walk" or stance == "Run" or stance == "Crouch"
		end,
	},
	-- Server to client
	WearSnapshot = {},
	EventPlay = {},
	Subtitle = {},
	Objective = {},
	Taken = {},
	SliceEnd = {},
	DebugState = { Unreliable = true },
}

local Net = {}
Net.Names = {} :: { [string]: string }
for name in Defs do
	Net.Names[name] = name
end

local folder: Folder? = nil
local remotes: { [string]: any } = {}

function Net.Init()
	assert(RunService:IsServer(), "Net.Init is server-only")
	local f = Instance.new("Folder")
	f.Name = "Remotes"
	for name, def in Defs do
		local r = Instance.new(if def.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent")
		r.Name = name
		r.Parent = f
		remotes[name] = r
	end
	f.Parent = ReplicatedStorage
	folder = f
end

local function remote(name: string): any
	local r = remotes[name]
	if r then
		return r
	end
	assert(Defs[name], "unknown remote " .. name)
	if not folder then
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	r = (folder :: Folder):WaitForChild(name)
	remotes[name] = r
	return r
end

-- Per-player token bucket so a client can't flood a remote.
local buckets: { [Player]: { [string]: { tokens: number, at: number } } } = {}
if RunService:IsServer() then
	Players.PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

local function allow(player: Player, name: string, rate: number): boolean
	local now = os.clock()
	local pb = buckets[player]
	if not pb then
		pb = {}
		buckets[player] = pb
	end
	local b = pb[name]
	if not b then
		b = { tokens = rate, at = now }
		pb[name] = b
	end
	b.tokens = math.min(rate, b.tokens + (now - b.at) * rate)
	b.at = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function Net.OnServer(name: string, handler: (Player, ...any) -> ())
	local def = Defs[name]
	assert(def and def.Validate, name .. " is not a client-to-server remote")
	local validate = def.Validate :: Validator
	local rate = def.RatePerSecond or 4
	remote(name).OnServerEvent:Connect(function(player: Player, ...)
		if not allow(player, name, rate) then
			return
		end
		local ok, valid = pcall(validate, ...)
		if not ok or not valid then
			return
		end
		handler(player, ...)
	end)
end

function Net.Fire(player: Player, name: string, ...: any)
	remote(name):FireClient(player, ...)
end

function Net.FireAll(name: string, ...: any)
	remote(name):FireAllClients(...)
end

function Net.OnClient(name: string, handler: (...any) -> ())
	remote(name).OnClientEvent:Connect(handler)
end

function Net.FireServer(name: string, ...: any)
	remote(name):FireServer(...)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Janitor</string>
            <string name="Source"><![CDATA[--!strict
-- Owns things that need cleaning up (connections, instances, threads, functions, objects with Destroy).
-- Cleanup runs in reverse order of addition.
local Janitor = {}
Janitor.__index = Janitor

export type Janitor = typeof(setmetatable({} :: { _items: { any } }, Janitor))

function Janitor.new(): Janitor
	return setmetatable({ _items = {} }, Janitor)
end

function Janitor.Add<T>(self: Janitor, item: T): T
	table.insert(self._items, item)
	return item
end

local function clean(item: any)
	local t = typeof(item)
	if t == "function" then
		item()
	elseif t == "RBXScriptConnection" then
		item:Disconnect()
	elseif t == "Instance" then
		item:Destroy()
	elseif t == "thread" then
		pcall(task.cancel, item)
	elseif t == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Janitor.Cleanup(self: Janitor)
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		clean(items[i])
	end
end

Janitor.Destroy = Janitor.Cleanup

return Janitor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">LayoutSpace</string>
            <string name="Source"><![CDATA[--!strict
-- Converts between layout-local (x, z on the floor plan) and world space.
local Layout = require(script.Parent.Parent.Config.LevelLayout)

local LayoutSpace = {}
local O = Layout.Origin
LayoutSpace.Origin = Vector3.new(O[1], O[2], O[3])

function LayoutSpace.ToWorld(x: number, y: number, z: number): Vector3
	return LayoutSpace.Origin + Vector3.new(x, y, z)
end

function LayoutSpace.ToLocal(p: Vector3): Vector3
	return p - LayoutSpace.Origin
end

return LayoutSpace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Loader</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Starts services (server) or controllers (client) in an explicit order.
	Each module returns a table with optional Init(registry) and Start() methods.
	Init runs for all modules first (wire references), then Start for all (begin work).
]]
export type Registry = { [string]: any }

local Loader = {}

function Loader.Run(container: Instance, order: { string }): Registry
	local registry: Registry = {}
	local modules = {}
	for _, name in order do
		local m = container:FindFirstChild(name)
		assert(m and m:IsA("ModuleScript"), "missing module " .. name)
		local mod = (require :: any)(m)
		registry[name] = mod
		table.insert(modules, { name = name, mod = mod })
	end
	-- Warn about modules that exist but were left out of the order list (likely a mistake).
	for _, child in container:GetChildren() do
		if child:IsA("ModuleScript") and registry[child.Name] == nil then
			warn("[Loader] " .. child.Name .. " is not in the start order and was not loaded")
		end
	end
	for _, e in modules do
		if type(e.mod.Init) == "function" then
			e.mod:Init(registry)
		end
	end
	for _, e in modules do
		if type(e.mod.Start) == "function" then
			task.spawn(function()
				e.mod:Start()
			end)
		end
	end
	return registry
end

return Loader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RingBuffer</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Fixed-capacity ring buffer. Index 1 = oldest retained item.
local RingBuffer = {}
RingBuffer.__index = RingBuffer

export type RingBuffer<T> = {
	Push: (self: RingBuffer<T>, item: T) -> (),
	Get: (self: RingBuffer<T>, i: number) -> T?,
	Size: (self: RingBuffer<T>) -> number,
	Capacity: number,
	Total: number, -- items ever pushed
}

function RingBuffer.new<T>(capacity: number): RingBuffer<T>
	assert(capacity >= 1, "capacity must be >= 1")
	local self = { _data = table.create(capacity), _head = 0, _count = 0, Capacity = capacity, Total = 0 }
	return (setmetatable(self, RingBuffer) :: any) :: RingBuffer<T>
end

function RingBuffer:Push(item)
	self._head = (self._head % self.Capacity) + 1
	self._data[self._head] = item
	if self._count < self.Capacity then
		self._count += 1
	end
	self.Total += 1
end

function RingBuffer:Size(): number
	return self._count
end

function RingBuffer:Get(i: number)
	if i < 1 or i > self._count then
		return nil
	end
	-- oldest index = head - count + 1 (wrapped)
	local idx = ((self._head - self._count + i - 1) % self.Capacity) + 1
	return self._data[idx]
end

return RingBuffer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Minimal synchronous signal. Handlers run in connection order; a disconnected handler never runs again.
export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }
export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new<T...>(): Signal<T...>
	local self = setmetatable({ _handlers = {} :: { any } }, Signal)
	return (self :: any) :: Signal<T...>
end

function Signal:Connect(fn)
	local conn: any
	conn = {
		Connected = true,
		_fn = fn,
		Disconnect = function(c)
			if not c.Connected then
				return
			end
			c.Connected = false
			local list = self._handlers
			local i = table.find(list, c)
			if i then
				table.remove(list, i)
			end
		end,
	}
	table.insert(self._handlers, conn)
	return conn
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	-- Copy so handlers may disconnect during dispatch.
	local snapshot = table.clone(self._handlers)
	for _, c in snapshot do
		if c.Connected then
			c._fn(...)
		end
	end
end

function Signal:DisconnectAll()
	for _, c in table.clone(self._handlers) do
		c:Disconnect()
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
