            <string name="Name">AssetIds</string>
            <string name="Source"><![CDATA[--!strict
-- Every asset reference lives here. Empty string = not sourced yet; callers skip it.
-- rbxasset:// paths ship with the Roblox client and need no upload.
return {
	Sounds = {
		FootstepLino = "rbxasset://sounds/action_footsteps_plastic.mp3",
		FootstepConcrete = "rbxasset://sounds/action_footsteps_plastic.mp3",
		FootstepWater = "rbxasset://sounds/action_footsteps_plastic.mp3",
		DoorOpen = "",
		DoorClose = "",
		DoorKnock = "",
		FlashlightClick = "",
		Breath = "",
		LodgerInhale = "",
		FluorescentHum = "",
		RoomTone = "",
		Rain = "",
		LiftPower = "",
	},
	Animations = {
		-- Default R15 walk; confirm id in Studio (S5).
		Walk = "rbxassetid://507777826",
	},
	Decals = {
		Footprint = "",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AudioConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Mix buses and per-sound defaults. Volumes are linear.
return {
	Buses = {
		Ambience = 0.6,
		World = 1.0,
		Player = 0.8,
		Echo = 0.85,
		Lodger = 1.0,
		UI = 0.7,
	},
	-- Distance attenuation curves: {[distance] = volume}
	Curves = {
		Default = { [0] = 1, [10] = 0.7, [40] = 0.25, [90] = 0 },
		Footstep = { [0] = 1, [6] = 0.6, [30] = 0.15, [60] = 0 },
		Far = { [0] = 1, [30] = 0.6, [120] = 0.15, [200] = 0 },
	},
	AcousticSimulation = true,
	-- Fallback occlusion when acoustic simulation is off: low-pass when the ray to the emitter is blocked.
	OcclusionFallback = { CheckSeconds = 0.25, BlockedFrequency = 900, OpenFrequency = 20000 },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">DirectorConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Pacing. See §J. Times in seconds.
return {
	TickSeconds = 1,
	States = {
		Relax = { MinSeconds = 45, MaxSeconds = 90 },
		Build = { MaxSeconds = 240 },
		Peak = { MaxSeconds = 60 },
		Fade = { MinSeconds = 20, MaxSeconds = 35 },
	},
	BuildToPeakTension = 60,
	TensionDecayPerSecond = 0.6,
	TensionFromRunPerSecond = 1.5,
	TensionFromDarkPerSecond = 0.2,
	TensionFromLodgerNearPerSecond = 6,
	-- Event spacing.
	MinSecondsBetweenEvents = 20,
	MinSecondsBetweenMajor = 240, -- intensity >= 4
	MajorIntensity = 4,
	PostDeathRelaxSeconds = 90,
	RecentCategoryPenalty = 0.35, -- weight multiplier per recent play of the same category
	RecentWindowSeconds = 300,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">EchoConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Recording and replay of player history. See §D.2.
return {
	SampleHz = 4,
	-- How much history each player keeps (seconds).
	HistorySeconds = 360,
	-- Echoes replay a slice of history recorded between these many seconds ago.
	MinDelaySeconds = 45,
	MaxDelaySeconds = 240,
	-- Positions are quantised to this many studs before sending.
	Quantum = 0.25,
	-- Figure echo visuals.
	FigureTransparency = 0.35,
	FigureMaxDistance = 140,
	-- "Behind you" footsteps lag the player by this many seconds.
	BehindYouLagSeconds = 1.0,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">LevelLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Floor 4 East greybox layout (VERTICAL_SLICE_SPEC.md §1), as plain data so it can be
	unit-tested outside Roblox. Units are studs, floor at Y = 0. Rects are {x0, z0, x1, z1}.

	Openings sit on a cell edge. Axis = which coordinate the wall is perpendicular to:
	  Axis "Z": wall runs along X at z = At, opening centred on x = Center.
	  Axis "X": wall runs along Z at x = At, opening centred on z = Center.
	Kinds:
	  Door    - hinged door, starts closed
	  Arch    - open gap, no door
	  Plastic - sealed with plastic sheeting; hold to cut, then an open gap
	  Lift    - lift doors, locked until power is restored
	  Fake    - door slab on a solid wall (knockable, never opens)
]]

export type Rect = { number }
export type CellDef = { Id: string, Rect: Rect, Tags: { string }?, FloorColor: { number }? }
export type OpeningDef = {
	Id: string,
	Kind: "Door" | "Arch" | "Plastic" | "Lift" | "Fake",
	Cells: { string },
	Axis: "X" | "Z",
	At: number,
	Center: number,
	Width: number?,
	Label: string?,
}
export type WallDef = { Axis: "X" | "Z", At: number, From: number, To: number, Cell: string }
export type PointDef = { Id: string, Kind: string, Cell: string, Pos: { number }, Data: { [string]: any }? }

local Layout = {}

Layout.Height = 11
Layout.WallThickness = 0.5
Layout.DoorWidth = 5
Layout.DoorHeight = 8
Layout.Origin = { 0, 100, 0 } -- whole floor is built at this offset (floor 4 sits above ground)

Layout.Cells = {
	{ Id = "StairA", Rect = { -12, 0, 0, 9 }, Tags = { "Stair" }, FloorColor = { 90, 90, 88 } },
	{ Id = "CorrW", Rect = { 0, 0, 60, 9 }, Tags = { "LongCorridor" }, FloorColor = { 70, 92, 74 } },
	{ Id = "CorrE", Rect = { 60, 0, 120, 9 }, Tags = { "LongCorridor" }, FloorColor = { 70, 92, 74 } },
	{ Id = "Lobby", Rect = { 120, 0, 132, 9 }, Tags = { "LiftLobby" }, FloorColor = { 80, 80, 80 } },
	{ Id = "Lift", Rect = { 132, 1.5, 138, 7.5 }, Tags = { "Lift" }, FloorColor = { 60, 60, 64 } },
	{ Id = "R4B", Rect = { 24, 9, 44, 29 }, Tags = { "Apartment" }, FloorColor = { 96, 82, 66 } },
	{ Id = "Laundry", Rect = { 64, 9, 84, 29 }, Tags = { "Laundry", "Noisy" }, FloorColor = { 84, 86, 90 } },
	{ Id = "R4D", Rect = { 90, 9, 112, 29 }, Tags = { "Apartment", "Sealed" }, FloorColor = { 96, 82, 66 } },
	{ Id = "R4E", Rect = { 40, -20, 80, 0 }, Tags = { "Apartment", "Water" }, FloorColor = { 52, 64, 76 } },
	{ Id = "Closet", Rect = { 100, -10, 112, 0 }, Tags = { "Closet" }, FloorColor = { 80, 76, 70 } },
} :: { CellDef }

Layout.Openings = {
	{ Id = "StairDoor", Kind = "Door", Cells = { "StairA", "CorrW" }, Axis = "X", At = 0, Center = 4.5 },
	{
		Id = "Dogleg",
		Kind = "Arch",
		Cells = { "CorrW", "CorrE" },
		Axis = "X",
		At = 60,
		Center = 6.75,
		Width = 4.5,
	},
	{
		Id = "LobbyArch",
		Kind = "Arch",
		Cells = { "CorrE", "Lobby" },
		Axis = "X",
		At = 120,
		Center = 4.5,
		Width = 6,
	},
	{ Id = "LiftDoor", Kind = "Lift", Cells = { "Lobby", "Lift" }, Axis = "X", At = 132, Center = 4.5 },
	{ Id = "Door4A", Kind = "Fake", Cells = { "CorrW" }, Axis = "Z", At = 9, Center = 15, Label = "4A" },
	{
		Id = "Door4B",
		Kind = "Door",
		Cells = { "CorrW", "R4B" },
		Axis = "Z",
		At = 9,
		Center = 34,
		Label = "4B",
	},
	{
		Id = "DoorLaundry",
		Kind = "Door",
		Cells = { "CorrE", "Laundry" },
		Axis = "Z",
		At = 9,
		Center = 74,
		Label = "LAUNDRY",
	},
	{
		Id = "Door4D",
		Kind = "Plastic",
		Cells = { "CorrE", "R4D" },
		Axis = "Z",
		At = 9,
		Center = 100,
		Label = "4D",
	},
	{ Id = "Door4F", Kind = "Fake", Cells = { "CorrW" }, Axis = "Z", At = 0, Center = 20, Label = "4F" },
	{
		Id = "Door4E_W",
		Kind = "Door",
		Cells = { "CorrW", "R4E" },
		Axis = "Z",
		At = 0,
		Center = 48,
		Label = "4E",
	},
	{
		Id = "Door4E_E",
		Kind = "Door",
		Cells = { "CorrE", "R4E" },
		Axis = "Z",
		At = 0,
		Center = 74,
		Label = "4E",
	},
	{
		Id = "DoorCloset",
		Kind = "Door",
		Cells = { "CorrE", "Closet" },
		Axis = "Z",
		At = 0,
		Center = 106,
		Label = "CARETAKER",
	},
} :: { OpeningDef }

-- Free-standing walls (the dog-leg chicane that breaks the corridor sightline).
Layout.ExtraWalls = {
	{ Axis = "X", At = 66, From = 4.5, To = 9, Cell = "CorrE" },
} :: { WallDef }

Layout.Points = {
	{ Id = "Spawn", Kind = "Spawn", Cell = "StairA", Pos = { -6, 3, 4.5 } },
	{
		Id = "Clipboard",
		Kind = "Note",
		Cell = "StairA",
		Pos = { -0.6, 4.5, 2 },
		Data = { NoteId = "Clipboard" },
	},
	{ Id = "Tape4B", Kind = "Tape", Cell = "R4B", Pos = { 40, 3, 26 }, Data = { TapeId = "Tape01" } },
	{ Id = "Fuse1", Kind = "Item", Cell = "Laundry", Pos = { 80, 3, 26 }, Data = { ItemId = "Fuse" } },
	{ Id = "Fuse2", Kind = "Item", Cell = "R4D", Pos = { 108, 3, 26 }, Data = { ItemId = "Fuse" } },
	{ Id = "FuseBox", Kind = "FuseBox", Cell = "Lobby", Pos = { 126, 4.5, 8.5 }, Data = { Needs = 2 } },
	{
		Id = "LightW",
		Kind = "Fluorescent",
		Cell = "CorrW",
		Pos = { 22, 10.6, 4.5 },
		Data = { Working = true },
	},
	{
		Id = "LightE",
		Kind = "Fluorescent",
		Cell = "CorrE",
		Pos = { 92, 10.6, 4.5 },
		Data = { Working = true },
	},
	{
		Id = "LightDead1",
		Kind = "Fluorescent",
		Cell = "CorrW",
		Pos = { 45, 10.6, 4.5 },
		Data = { Working = false },
	},
	{
		Id = "LightDead2",
		Kind = "Fluorescent",
		Cell = "CorrE",
		Pos = { 110, 10.6, 4.5 },
		Data = { Working = false },
	},
	{ Id = "Lamp4B", Kind = "Lamp", Cell = "R4B", Pos = { 30, 4, 25 }, Data = {} },
	{ Id = "StairWindow", Kind = "Sodium", Cell = "StairA", Pos = { -11.5, 7, 4.5 }, Data = {} },
	{ Id = "LodgerHome", Kind = "LodgerHome", Cell = "Laundry", Pos = { 70, 3, 24 } },
} :: { PointDef }

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">LodgerConfig</string>
            <string name="Source"><![CDATA[--!strict
-- The Lodger's perception and movement. See §I.
return {
	WalkSpeed = 8, -- players walk at 10 and run at 17, so a running player always escapes
	PursueSpeed = 11,
	AgentRadius = 1.6,
	AgentHeight = 5,
	SightRange = 60,
	SightRangeFlashlightOn = 90,
	SightConeDegrees = 110,
	HearingRange = 70, -- loudness 1.0 heard this far through open space
	DoorMuffle = 0.35, -- each closed door between multiplies loudness by this
	CatchDistance = 3.2,
	DeviateHoldSeconds = 2.2,
	SearchSeconds = 12,
	WithdrawGiveUpSeconds = 20, -- after this, a withdrawing Lodger may vanish while seen but not looked at
	WithdrawMaxSeconds = 30, -- hard cap: despawns even if watched (no route out of sight exists)
	MimicDeviateDistance = 45, -- end of a mimic route this close to the target: it turns to face them
	LoseSightSeconds = 4,
	-- Menace gauge (Alien: Isolation pattern). Rises while near/visible, forces Withdraw when full.
	MenaceRisePerSecondNear = 0.12,
	MenaceDecayPerSecond = 0.05,
	MenaceNearDistance = 30,
	MenaceWithdrawAt = 1.0,
	RepathSeconds = 0.6,
	-- Mimic: walk a player's echo route recorded this long ago.
	MimicDelaySeconds = 60,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">PlayerConfig</string>
            <string name="Source"><![CDATA[--!strict
return {
	WalkSpeed = 10,
	RunSpeed = 17,
	CrouchSpeed = 5,
	CrouchCameraDrop = 1.6,
	RunSpeedThreshold = 13.5, -- server classifies horizontal speed above this as running
	CrouchSpeedThreshold = 6,
	HeadBob = { Amplitude = 0.08, Frequency = 7 },
	FieldOfView = 72,
	InteractDistance = 9,
	-- Avatar clamps so extreme avatars don't break tone (§S risks).
	BodyScaleClamp = { Min = 0.9, Max = 1.05 },
}
]]></string>
          </Properties>
        </Item>
